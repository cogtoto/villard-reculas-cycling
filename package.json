{
  "name": "velo-virtuel",
  "version": "0.5.18",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "android:sync": "vite build && node -e \"require('fs').rmSync('dist/pornichet-croisic.gpx',{force:true})\" && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew clean assembleDebug"
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "express": "^4.21.2",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "vite": "^6.0.0",
    "xml2js": "^0.6.2"
  }
}
